# ==============================================================================
# QUANTUMANIA - Environment Configuration Template
# Phase 0: Project Foundation
# NOTE: Copy this file to .env before starting local development.
# NEVER commit .env or any real credentials to version control.
# ==============================================================================

# Server & Network
PORT=8000
NODE_ENV=development
API_BASE_URL=http://localhost:8000
CLIENT_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL=postgresql://user:password@localhost:5432/quantumania
# SQLite alternative for zero-setup local dev:
# DATABASE_URL=sqlite:///./dev.db

# Authentication & Security
SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Tutor Provider (e.g., Google Gemini / OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_provider_api_key_here
AI_MODEL_NAME=gemini-1.5-pro

# Quantum Simulation Engine
QUANTUM_SIMULATOR_BACKEND=local_statevector
QUANTUM_MAX_QUBITS=10
QUANTUM_DEFAULT_SHOTS=1024
QUANTUM_MAX_SHOTS=8192
QUANTUM_SIMULATION_TIMEOUT_MS=5000

# Logging & Observability
LOG_LEVEL=info
