# ==============================================================================
# QUANTUMANIA - Environment Configuration Template
# Phase 7: Production Readiness, Full Integration, Validation & Final SIH Demo
# NOTE: Copy this file to .env before starting local development.
# NEVER commit .env or any real credentials to version control.
# ==============================================================================

# Server & Network Configuration
PORT=8000
NODE_ENV=development
API_BASE_URL=http://localhost:8000
CLIENT_ORIGIN=http://localhost:3000

# Database Configuration (Defaults to local SQLite for zero-config local development)
DATABASE_URL=sqlite:///./dev.db
# PostgreSQL alternative for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/quantumania

# Authentication & Security
SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Quantum Tutor Engine (Google Gemini / OpenAI / Deterministic Local Engine)
# AI_PROVIDER options: "auto" (default: uses available API key or fallback), "gemini", "openai", "fallback"
AI_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gemini-1.5-flash
TUTOR_MAX_HISTORY=10
TUTOR_TEMPERATURE=0.2

# Quantum Simulation Engine
QUANTUM_SIMULATOR_BACKEND=local_statevector
QUANTUM_MAX_QUBITS=8
QUANTUM_DEFAULT_SHOTS=1024
QUANTUM_MAX_SHOTS=8192

# Logging & Observability
LOG_LEVEL=info
